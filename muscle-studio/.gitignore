# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# decoders copied from node_modules/three by scripts/copy-decoders.mjs
/public/decoders

!.env.example

# BodyParts3D source download for pipeline/bodyparts3d (not committed)
/bp3d
.netlify

# Écorché model: only the compressed web build (public/models/ecorche/<sex>/*.glb + build.json)
# is in the repository. The original files (Blender scenes, textures) are never committed.
*.blend
*.blend1
